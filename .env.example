# Local development (Windows / Docker Compose PostgreSQL)
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://ultimate:change_this_password@localhost:5432/ultimate_router
DATABASE_SSL=disable
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000

# Production values are set in the Railway / Cloudflare dashboards, NOT committed here:
# Railway (backend service):
#   NODE_ENV=production
#   PORT=<provided by Railway>
#   DATABASE_URL=<Railway PostgreSQL reference: ${{Postgres.DATABASE_URL}}>
#   DATABASE_SSL=require
#   CORS_ORIGIN=https://ultimate-router-web.<account>.workers.dev
# Cloudflare Workers Builds (build-time):
#   VITE_API_URL=https://ultimaterouter-production.up.railway.app
