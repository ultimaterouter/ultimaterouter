{
  "name": "ultimate-router",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/backend", "apps/web"],
  "scripts": {
    "dev": "concurrently -n backend,web -c blue,green \"npm run dev -w apps/backend\" \"npm run dev -w apps/web\"",
    "dev:backend": "npm run dev -w apps/backend",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w apps/web",
    "start:backend": "node scripts/start-backend.mjs",
    "test": "npm run test -w apps/backend",
    "db:migrate": "npm run db:migrate -w apps/backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "pg-mem": "^3.0.14",
    "wrangler": "4.168.0"
  }
}
